## 📦 类设计原则

- **单一职责**：每个类只负责一个明确的功能
- **不可变性**：优先使用 readonly 属性
- **依赖注入**：通过构造函数注入依赖

```typescript
export class ValidationContext {
  readonly rules: ValidationRule[]
  readonly options: Required<ValidationOptions>
  
  private _errors: ValidationError[] = []
  private _isValidating = false
  
  constructor(rules: ValidationRule[], options?: ValidationOptions) {
    this.rules = Object.freeze([...rules])
    this.options = { ...DEFAULT_OPTIONS, ...options }
  }
  
  validate(data: unknown): ValidationResult {
    return this._performValidation(data)
  }
  
  private _performValidation(data: unknown): ValidationResult {
    // 验证逻辑
  }
}
```

