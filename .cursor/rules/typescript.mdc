## ⚡ 性能优化规范

### 响应式使用原则
- **避免过度响应式**：只对需要响应的数据使用响应式
- **延迟初始化**：大对象使用延迟初始化
- **内存清理**：及时清理事件监听器和定时器

```typescript
export class ComponentContext {
  readonly config: ComponentConfig  // 配置数据不需要响应式
  
  private _state = reactive<ComponentState>({  // 状态数据使用响应式
    loading: false,
    data: null
  })
  
  private _heavyObject?: HeavyObject  // 延迟初始化
  
  get heavyObject(): HeavyObject {
    if (!this._heavyObject) {
      this._heavyObject = new HeavyObject()
    }
    return this._heavyObject
  }
  
  destroy(): void {
    this._clearTimers()
    this._removeEventListeners()
    this._heavyObject?.dispose()
  }
}
```

