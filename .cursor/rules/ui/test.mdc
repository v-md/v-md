# 💻 测试代码编写规范

## 组件测试代码模板

```typescript
import { mount } from '@vue/test-utils'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { nextTick, ref } from 'vue'
import ComponentName from '../view/component-name.vue'
import ComponentSubItem from '../view/component-sub-item.vue'

describe('componentName', () => {
  beforeEach(() => {
    // 设置假定时器（如需要）
    vi.useFakeTimers()
  })

  afterEach(() => {
    // 恢复真实定时器（如需要）
    vi.useRealTimers()
  })

  describe('basic rendering', () => {
    it('should render correctly with default props', () => {
      const wrapper = mount(() => (
        <ComponentName>
          <div>Content</div>
        </ComponentName>
      ))

      // 验证组件正确渲染
      expect(wrapper.find('.expected-class').exists()).toBe(true)
      expect(wrapper.text()).toContain('Content')
    })

    it('should render with sub components', () => {
      const wrapper = mount(() => (
        <ComponentName>
          <ComponentSubItem>Item 1</ComponentSubItem>
          <ComponentSubItem>Item 2</ComponentSubItem>
        </ComponentName>
      ))

      // 验证子组件正确渲染
      expect(wrapper.findAll('.sub-item-class')).toHaveLength(2)
      expect(wrapper.text()).toContain('Item 1')
      expect(wrapper.text()).toContain('Item 2')
    })
  })

  describe('props', () => {
    it('should handle string prop', () => {
      const wrapper = mount(() => (
        <ComponentName propName="test-value">
          <div>Content</div>
        </ComponentName>
      ))

      // 验证字符串属性处理
      expect(wrapper.get('[data-testid="target-element"]')).toBeTruthy()
    })

    it('should handle reactive props', async () => {
      const propValue = ref('initial')
      const wrapper = mount(() => (
        <ComponentName propName={propValue.value}>
          <div>Content</div>
        </ComponentName>
      ))

      // 验证初始值
      expect(wrapper.text()).toContain('initial')

      // 验证响应式更新
      propValue.value = 'updated'
      await nextTick()
      expect(wrapper.text()).toContain('updated')
    })
  })

  describe('events', () => {
    it('should emit events correctly', async () => {
      const onCustomEvent = vi.fn()
      const wrapper = mount(() => (
        <ComponentName onCustomEvent={onCustomEvent}>
          <div>Content</div>
        </ComponentName>
      ))

      // 触发事件并验证
      const component = wrapper.findComponent(ComponentName)
      await component.vm.$emit('customEvent', 'payload')
      expect(onCustomEvent).toHaveBeenCalledWith('payload')
    })
  })

  describe('exposed methods', () => {
    it('should expose required methods', () => {
      const wrapper = mount(() => (
        <ComponentName>
          <div>Content</div>
        </ComponentName>
      ))

      // 验证暴露的方法
      const component = wrapper.findComponent(ComponentName)
      expect(typeof component.vm.exposedMethod).toBe('function')
    })
  })
})
```

## 组合式函数测试代码模板

```typescript
import { describe, it, expect, beforeEach, vi } from 'vitest'
import { ref, nextTick } from 'vue'
import { useComposableName } from '../composables'

describe('useComposableName', () => {
  beforeEach(() => {
    // 清理所有模拟函数
    vi.clearAllMocks()
  })

  describe('basic functionality', () => {
    it('should initialize state correctly', () => {
      const { state, method } = useComposableName()
      
      // 验证状态初始化
      expect(state.value).toBeDefined()
      expect(typeof method).toBe('function')
    })

    it('should handle parameters correctly', () => {
      const mockParam = 'test-param'
      const { method } = useComposableName()
      
      // 验证参数处理
      const result = method(mockParam)
      expect(result).toBe('expected-result')
    })
  })

  describe('reactive state', () => {
    it('should update reactive state correctly', async () => {
      const { state, updateState } = useComposableName()
      
      // 验证状态更新
      updateState('new-value')
      await nextTick()
      expect(state.value).toBe('new-value')
    })
  })

  describe('edge cases', () => {
    it('should handle invalid parameters correctly', () => {
      const { method } = useComposableName()
      
      // 验证异常参数处理
      expect(() => method(null)).not.toThrow()
      expect(() => method(undefined)).not.toThrow()
    })
  })
})
```

