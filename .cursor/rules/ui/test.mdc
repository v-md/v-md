# 🛠️ 测试工具和模拟规范

## Mock 使用规范

### 函数模拟
```typescript
// 简单函数模拟
const mockFunction = vi.fn()
mockFunction.mockReturnValue('mocked-value')
mockFunction.mockResolvedValue('async-mocked-value')

// 模块模拟
vi.mock('../utils/helper', () => ({
  helperFunction: vi.fn(() => 'mocked-result')
}))

// 部分模块模拟
vi.mock('../utils/helper', async () => {
  const actual = await vi.importActual('../utils/helper')
  return {
    ...actual,
    specificFunction: vi.fn(() => 'mocked-specific-result')
  }
})
```

### DOM API 模拟
```typescript
// 模拟浏览器 API
Object.defineProperty(window, 'getComputedStyle', {
  value: vi.fn(() => ({
    getPropertyValue: vi.fn(() => '100px')
  }))
})

// 模拟元素方法
Element.prototype.scrollIntoView = vi.fn()
Element.prototype.getBoundingClientRect = vi.fn(() => ({
  width: 100,
  height: 50,
  top: 0,
  left: 0,
  bottom: 50,
  right: 100
}))
```

### 时间相关模拟
```typescript
// 在测试套件中设置假定时器
beforeEach(() => {
  vi.useFakeTimers()
})

afterEach(() => {
  vi.useRealTimers()
})

// 测试中使用定时器
vi.advanceTimersByTime(1000) // 推进指定时间
vi.runAllTimers() // 运行所有定时器
vi.runAllTimersAsync() // 用于异步定时器

// 模拟特定日期
vi.setSystemTime(new Date('2024-01-01'))
```

